# Copy this file to .env.production and replace every placeholder.
# Use a 64-character hexadecimal password so it is safe in DATABASE_URL.
POSTGRES_DB=skillverse
POSTGRES_USER=skillverse
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32

# Public DNS name served by Caddy. Point DNS here and allow inbound TCP 80/443
# plus UDP 443 for HTTP/3 before starting the deployment.
SITE_ADDRESS=skills.example.org

# Same-origin web/API traffic does not require CORS. Keep this set to the
# browser origin if external clients or a separate frontend will call the API.
CORS_ORIGINS=https://skills.example.org

# Optional. Leave empty to use deterministic fallback reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APP_NAME=SKILLVERSE API
